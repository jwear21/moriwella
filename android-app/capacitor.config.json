{
  "appId": "com.moriwella.app",
  "appName": "Moriwella",
  "webDir": "www",
  "appendUserAgent": "MoriwellaApp",
  "server": {
    "url": "https://moriwella.com/app/",
    "cleartext": false,
    "allowNavigation": ["moriwella.com", "www.moriwella.com"],
    "errorPath": "offline.html"
  },
  "android": { "allowMixedContent": false },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1200, "backgroundColor": "#FBF7EE", "showSpinner": false },
    "StatusBar": { "style": "DARK", "backgroundColor": "#1B4D3E" }
  }
}
